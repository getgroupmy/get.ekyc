# Copy to .env and fill in the two secrets.

# Protects the admin console and /admin/api. Generate: openssl rand -hex 32
EKYC_ADMIN_TOKEN=

# Encrypts images and personal data at rest. Generate: openssl rand -base64 32
# BACK THIS UP SEPARATELY FROM THE DATA FOLDER. If it is lost, stored data cannot be read.
EKYC_STORAGE_KEY=

# Cloudflare tunnel token (only with: docker compose --profile tunnel up -d)
# TUNNEL_TOKEN=

# get-ride policy today: the face score is advisory and an admin decides.
# Keep this false to match it; set true to let clean results approve themselves.
EKYC_AUTO_APPROVE=false

# --- optional -----------------------------------------------------------------
# EKYC_PORT=8080
# EKYC_DATA_PATH=./data                 # Synology: /volume1/docker/ekyc/data
# EKYC_MIN_AGE=18
# EKYC_LIVENESS_DEFAULT=true
# EKYC_FACE_MATCH_THRESHOLD=0.363       # selfie vs document photo (cosine similarity)
# EKYC_FACE_REVIEW_THRESHOLD=0.25       # between the two => manual review
# EKYC_RETENTION_DAYS=0                 # delete images N days after a decision (0 = keep)
# EKYC_SESSION_TTL_MINUTES=60
# EKYC_MAX_UPLOAD_MB=12                 # face-server used 6
# EKYC_CORS_ORIGINS=https://app.example.com
# EKYC_PASSIVE_LIVENESS_ACTION=review   # or "reject"
# EKYC_OCR_ENGINE=onnxruntime          # PP-OCR engine: onnxruntime (Mac mini) | openvino (NAS, no AVX) | off

# Public address of this server: the base of hosted verification links (/v/…)
EKYC_PUBLIC_URL=https://ekyc.getcdn.link
